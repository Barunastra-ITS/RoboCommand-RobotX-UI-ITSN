# The vendored robocommand submodule tracks some __pycache__/*.pyc upstream,
# which .gitignore cannot ignore. .gitmodules sets `ignore = dirty` so the
# regenerated .pyc files never show the submodule as modified here.

# RoboCommand test-server session logs (docker compose bind-mounts ./logs)
robocommand/RobotX_2026/logs/

