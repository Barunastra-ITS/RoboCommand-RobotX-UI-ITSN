# Note: robocommand/RobotX_2026/gen/python/**/__pycache__/*.pyc are tracked
# upstream. Those regenerate whenever the UI imports the vendored protos, so
# running the app dirties the submodule. Restore them after a run:
#   git -C robocommand checkout -- \
#     'RobotX_2026/gen/python/__pycache__' \
#     'RobotX_2026/gen/python/robotx/__pycache__'

# RoboCommand test-server session logs (docker compose bind-mounts ./logs)
robocommand/RobotX_2026/logs/

